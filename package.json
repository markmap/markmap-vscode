{
  "name": "markmap-vscode",
  "version": "0.3.1",
  "description": "Visualize your markdown in VSCode",
  "author": "Gerald <gera2ld@live.com>",
  "license": "MIT",
  "displayName": "Markmap",
  "publisher": "gera2ld",
  "icon": "assets/favicon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Visualization"
  ],
  "keywords": [
    "markmap",
    "mindmap",
    "markdown"
  ],
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "markmap-vscode.open",
        "category": "Markmap",
        "title": "Open as markmap",
        "icon": {
          "light": "./assets/light.svg",
          "dark": "./assets/dark.svg"
        }
      },
      {
        "command": "markmap-vscode.toggle",
        "category": "Markmap",
        "title": "Toggle the active node"
      },
      {
        "command": "markmap-vscode.toggle-recursively",
        "category": "Markmap",
        "title": "Toggle the active node recursively"
      }
    ],
    "customEditors": [
      {
        "viewType": "markmap-vscode.markmap",
        "displayName": "Markmap",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "when": "editorLangId == markdown || editorLangId == mdx",
          "command": "markmap-vscode.open"
        },
        {
          "when": "editorLangId == markdown || editorLangId == mdx",
          "command": "markmap-vscode.toggle"
        },
        {
          "when": "editorLangId == markdown || editorLangId == mdx",
          "command": "markmap-vscode.toggle-recursively"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceLangId == markdown || resourceLangId == mdx",
          "command": "markmap-vscode.open",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "when": "activeEditor == workbench.editors.files.textFileEditor && (resourceLangId == markdown || resourceLangId == mdx)",
          "command": "markmap-vscode.open",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Markmap",
      "properties": {
        "markmap.defaultOptions": {
          "type": "string",
          "default": "",
          "markdownDescription": "Default options for Markmap as JSON, see <https://markmap.js.org/docs/guide/options> for the options. The options in a document win over these, and they do not apply to exported HTML.",
          "editPresentation": "multilineText"
        },
        "markmap.customCSS": {
          "type": "string",
          "default": "",
          "markdownDescription": "Custom CSS for the page around the map. To change colors, set the `--mm-*` properties on `markmap-view`, see <https://markmap.js.org/docs/guide/themes-and-layouts>. Rules cannot reach inside the map, and they do not apply to exported HTML.",
          "editPresentation": "multilineText"
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "scripts": {
    "prepare": "husky",
    "vscode:prepublish": "pnpm build",
    "clean": "del-cli dist",
    "build:js": "rolldown -c",
    "build": "pnpm lint:fix && pnpm clean && pnpm build:js",
    "lint": "oxlint && oxfmt --check src",
    "lint:fix": "oxlint --fix && oxfmt src",
    "test:links": "node --test e2e/links.test.mjs",
    "test:e2e": "pnpm test:e2e:web && pnpm test:e2e:desktop",
    "test:e2e:web": "node e2e/web.mjs",
    "test:e2e:desktop": "node e2e/desktop.mjs",
    "dev:pack": "npx @vscode/vsce pack"
  },
  "repository": "https://github.com/gera2ld/markmap-vscode",
  "main": "dist/extension.js",
  "browser": "dist/extension.js",
  "files": [
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "assets",
    "dist"
  ],
  "devDependencies": {
    "@markmap/canvas": "1.1.0",
    "@markmap/core": "1.1.0",
    "@markmap/element": "1.1.0",
    "@markmap/page": "1.1.0",
    "@markmap/plugin-math": "1.1.0",
    "@markmap/render": "1.1.0",
    "@markmap/toolbar": "1.1.0",
    "@markmap/view": "1.1.0",
    "@types/node": "^24.0.1",
    "@types/vscode": "~1.75.0",
    "@types/vscode-webview": "^1.57.5",
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^4.1.0",
    "del-cli": "^8.0.1",
    "es-toolkit": "^1.39.3",
    "github-slugger": "2.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "ovsx": "^1.2.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "playwright-core": "^1.65.0",
    "rolldown": "^1.3.0",
    "typescript": "^7.0.2",
    "vscode-uri": "^3.1.0"
  },
  "lint-staged": {
    "*.ts": [
      "oxlint --fix",
      "oxfmt"
    ]
  }
}
