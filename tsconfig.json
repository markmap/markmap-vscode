{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "types": ["node", "vscode-webview"],
    "noEmit": true
  },
  "include": [
    "src/**/*"
  ]
}
